---
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import type { Project } from '../data/projects';
import { type Lang, useTranslations, localePath } from '../i18n/ui';

const { lang, project } = Astro.props as { lang: Lang; project: Project };
const t = useTranslations(lang);
const { Content } = await render(project);
const { title, summary, stack, repo, demo, image, imageAlt } = project.data;
---
<Base lang={lang} title={title} description={summary}>
  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <a href={localePath(lang, '/#projects')} class="text-sm text-zinc-500 hover:text-zinc-900 dark:hover:text-white">← {t('projects.back')}</a>
    <h1 class="mt-6 text-4xl font-extrabold tracking-tight text-zinc-950 dark:text-white">{title}</h1>
    <p class="mt-4 text-lg text-zinc-600 dark:text-zinc-400">{summary}</p>
    <ul class="mt-6 flex flex-wrap gap-1.5">
      {stack.map((s) => <li class="rounded bg-zinc-100 px-2 py-0.5 font-mono text-xs dark:bg-zinc-800">{s}</li>)}
    </ul>
    {(repo || demo) && (
      <div class="mt-6 flex gap-3">
        {repo && <a href={repo} class="rounded-lg border border-zinc-300 px-4 py-2 text-sm font-semibold hover:border-zinc-500 dark:border-zinc-700">{t('projects.repo')} ↗</a>}
        {demo && <a href={demo} class="rounded-lg bg-zinc-950 px-4 py-2 text-sm font-semibold text-white hover:bg-zinc-800 dark:bg-accent dark:text-zinc-950">{t('projects.demo')} ↗</a>}
      </div>
    )}
    {image && <img src={image} alt={imageAlt ?? ''} class="mt-10 w-full rounded-xl border border-zinc-200 dark:border-zinc-800" />}
    <div class="prose-case mt-12">
      <Content />
    </div>
  </article>
</Base>

<style is:global>
  @reference "../styles/global.css";
  .prose-case h2 { @apply mt-10 mb-3 text-2xl font-bold text-zinc-950 dark:text-white; }
  .prose-case p { @apply my-4 leading-7 text-zinc-700 dark:text-zinc-300; }
  .prose-case ul { @apply my-4 list-disc space-y-2 pl-6 text-zinc-700 dark:text-zinc-300; }
  .prose-case code { @apply rounded bg-zinc-100 px-1.5 py-0.5 font-mono text-sm dark:bg-zinc-800; }
  .prose-case blockquote { @apply my-6 border-l-4 border-accent pl-4 text-zinc-600 italic dark:text-zinc-400; }
  .prose-case pre { @apply my-6 overflow-x-auto rounded-lg bg-zinc-950 p-4 text-sm; }
  .prose-case pre code { @apply bg-transparent p-0; }
</style>
