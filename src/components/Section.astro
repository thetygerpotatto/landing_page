---
interface Props { id: string; title: string; sub?: string; tag?: string; alt?: boolean }
const { id, title, sub, tag, alt } = Astro.props;
---
<section id={id} class:list={['py-20 sm:py-24', alt && 'bg-zinc-50 dark:bg-zinc-900/40']}>
  <div class="mx-auto max-w-5xl px-4 sm:px-6">
    {tag && <p class="mb-2 font-mono text-sm text-accent-strong dark:text-accent">{tag}</p>}
    <h2 class="text-3xl font-bold tracking-tight text-zinc-950 sm:text-4xl dark:text-white">{title}</h2>
    {sub && <p class="mt-3 max-w-2xl text-zinc-600 dark:text-zinc-400">{sub}</p>}
    <div class="mt-10"><slot /></div>
  </div>
</section>
