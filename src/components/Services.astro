---
import Section from './Section.astro';
import { services, formatPrice } from '../data/services';
import { type Lang, useTranslations, localePath } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---
<Section id="services" tag="03 // services" title={t('services.title')} sub={t('services.sub')} alt>
  <div class="grid gap-6 lg:grid-cols-3">
    {services.map((s) => {
      const price = formatPrice(lang, s);
      return (
        <article class:list={[
          'flex flex-col rounded-xl border bg-white p-6 dark:bg-zinc-950',
          s.featured ? 'border-accent shadow-lg shadow-accent/10' : 'border-zinc-200 dark:border-zinc-800',
        ]}>
          <p class="font-mono text-2xl text-accent-strong dark:text-accent" aria-hidden="true">{s.icon}</p>
          <h3 class="mt-4 text-lg font-bold text-zinc-950 dark:text-white">{s.name[lang]}</h3>
          <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">{s.description[lang]}</p>
          <p class="mt-6 text-xs uppercase tracking-wide text-zinc-500">{t('services.from')}</p>
          <p class="text-3xl font-extrabold text-zinc-950 dark:text-white">{price.primary}</p>
          <p class="text-xs text-zinc-500">≈ {price.secondary}</p>
          <ul class="mt-6 flex-1 space-y-2 text-sm">
            {s.includes[lang].map((i) => (
              <li class="flex gap-2"><span class="text-accent-strong dark:text-accent" aria-hidden="true">✓</span>{i}</li>
            ))}
          </ul>
          <a href={localePath(lang, '/#contact')} class:list={[
            'mt-6 rounded-lg px-4 py-2.5 text-center text-sm font-semibold transition',
            s.featured
              ? 'bg-zinc-950 text-white hover:bg-zinc-800 dark:bg-accent dark:text-zinc-950 dark:hover:bg-accent/90'
              : 'border border-zinc-300 hover:border-zinc-500 dark:border-zinc-700',
          ]}>{t('services.cta')}</a>
        </article>
      );
    })}
  </div>
  <div class="mt-6 flex flex-col items-start justify-between gap-4 rounded-xl border border-dashed border-zinc-300 p-6 sm:flex-row sm:items-center dark:border-zinc-700">
    <div>
      <h3 class="font-bold text-zinc-950 dark:text-white">{t('services.custom.title')}</h3>
      <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{t('services.custom.body')}</p>
    </div>
    <a href={localePath(lang, '/#contact')} class="shrink-0 text-sm font-semibold text-accent-strong hover:underline dark:text-accent">{t('services.cta')} →</a>
  </div>
  <p class="mt-4 text-xs text-zinc-500">{t('services.note')}</p>
</Section>
