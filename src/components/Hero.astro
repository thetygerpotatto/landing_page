---
import { site } from '../site.config';
import { type Lang, useTranslations, localePath } from '../i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
---
<section class="relative overflow-hidden">
  <div class="mx-auto grid max-w-5xl items-center gap-12 px-4 pt-16 pb-20 sm:px-6 sm:pt-24 md:grid-cols-[1.2fr_1fr]">
    <div>
      {site.openToWork && (
        <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-accent/40 bg-accent/10 px-3 py-1 text-xs font-medium text-accent-strong dark:text-accent">
          <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-75 motion-reduce:hidden"></span><span class="relative inline-flex size-2 rounded-full bg-accent"></span></span>
          {t('hero.status')}
        </p>
      )}
      <p class="font-mono text-sm text-zinc-500">{site.name} · {t('hero.role')}</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight text-balance text-zinc-950 sm:text-5xl dark:text-white">{t('hero.headline')}</h1>
      <p class="mt-5 max-w-xl text-lg text-zinc-600 dark:text-zinc-400">{t('hero.sub')}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={localePath(lang, '/#contact')} class="rounded-lg bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-zinc-800 dark:bg-accent dark:text-zinc-950 dark:hover:bg-accent/90">{t('hero.cta.hire')}</a>
        <a href={site.cv[lang]} download class="rounded-lg border border-zinc-300 px-5 py-2.5 text-sm font-semibold transition hover:border-zinc-500 dark:border-zinc-700 dark:hover:border-zinc-500">{t('hero.cta.cv')}</a>
        <a href={localePath(lang, '/#projects')} class="px-2 py-2.5 text-sm font-semibold text-zinc-600 hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white">{t('hero.cta.projects')} →</a>
      </div>
    </div>

    <!-- Decorative terminal card: a nod to C -->
    <div aria-hidden="true" class="rounded-xl border border-zinc-200 bg-zinc-950 font-mono text-[13px] leading-relaxed text-zinc-300 shadow-xl shadow-zinc-950/10 dark:border-zinc-800">
      <div class="flex gap-1.5 border-b border-zinc-800 px-4 py-3">
        <span class="size-3 rounded-full bg-zinc-700"></span><span class="size-3 rounded-full bg-zinc-700"></span><span class="size-3 rounded-full bg-zinc-700"></span>
      </div>
      <pre class="overflow-x-auto p-5"><code><span class="text-fuchsia-400">#include</span> <span class="text-amber-300">&lt;stdio.h&gt;</span>

<span class="text-sky-400">int</span> <span class="text-accent">main</span>(<span class="text-sky-400">void</span>) {'{'}
    <span class="text-sky-400">const char</span> *stack[] = {'{'}
        <span class="text-amber-300">"C"</span>, <span class="text-amber-300">"Linux"</span>,
        <span class="text-amber-300">"APIs"</span>, <span class="text-amber-300">"Web"</span>
    {'}'};
    <span class="text-accent">printf</span>(<span class="text-amber-300">"Let's build.\n"</span>);
    <span class="text-fuchsia-400">return</span> <span class="text-orange-300">0</span>;
{'}'}</code></pre>
    </div>
  </div>
</section>
