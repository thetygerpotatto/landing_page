---
import { site } from '../site.config';
import { type Lang, useTranslations, localePath, alternatePath } from '../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const alt = alternatePath(lang, Astro.url.pathname);
const links = [
  { href: localePath(lang, '/#about'), label: t('nav.about') },
  { href: localePath(lang, '/#projects'), label: t('nav.projects') },
  { href: localePath(lang, '/#services'), label: t('nav.services') },
  { href: localePath(lang, '/#contact'), label: t('nav.contact') },
];
---

<header class="sticky top-0 z-40 border-b border-zinc-200/70 bg-white/80 backdrop-blur dark:border-zinc-800/70 dark:bg-zinc-950/80">
  <nav class="mx-auto flex h-16 max-w-5xl items-center justify-between gap-4 px-4 sm:px-6">
    <a href={localePath(lang, '/')} class="font-mono text-sm font-semibold tracking-tight">
      <span class="text-accent-strong dark:text-accent">~/</span>{site.initials.toLowerCase()}
    </a>
    <ul class="hidden items-center gap-6 text-sm md:flex">
      {links.map((l) => (
        <li><a href={l.href} class="text-zinc-600 transition hover:text-zinc-950 dark:text-zinc-400 dark:hover:text-white">{l.label}</a></li>
      ))}
    </ul>
    <div class="flex items-center gap-2">
      <a
        href={alt.href}
        hreflang={alt.lang}
        aria-label={t('nav.lang')}
        title={t('nav.lang')}
        class="rounded-md border border-zinc-200 px-2.5 py-1.5 font-mono text-xs uppercase transition hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600"
      >{alt.lang}</a>
      <button
        id="theme-toggle"
        type="button"
        aria-label={t('nav.theme')}
        title={t('nav.theme')}
        class="rounded-md border border-zinc-200 p-1.5 transition hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600"
      >
        <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
        <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
      </button>
    </div>
  </nav>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
  });
</script>
