---
import Base from '../layouts/Base.astro';
---
<Base lang="en" title="404 · Page not found">
  <section class="mx-auto flex max-w-xl flex-col items-center px-4 py-32 text-center">
    <p class="font-mono text-sm text-accent-strong dark:text-accent">$ ./page --find</p>
    <h1 class="mt-3 text-6xl font-extrabold text-zinc-950 dark:text-white">404</h1>
    <p class="mt-4 text-zinc-600 dark:text-zinc-400">
      Segmentation fault: this page doesn't exist.<br />
      <span lang="es">Esta página no existe.</span>
    </p>
    <div class="mt-8 flex gap-3">
      <a href="/" class="rounded-lg bg-zinc-950 px-5 py-2.5 text-sm font-semibold text-white hover:bg-zinc-800 dark:bg-accent dark:text-zinc-950">Home</a>
      <a href="/es/" class="rounded-lg border border-zinc-300 px-5 py-2.5 text-sm font-semibold hover:border-zinc-500 dark:border-zinc-700">Inicio</a>
    </div>
  </section>
</Base>
